+/* Feature-scoped additions: leave the accepted Colorful and zoom styles intact. */
+#artTools section[hidden],#selectionPanel[hidden],#selectionLayer[hidden],#selectionBox[hidden],#selectionPreview[hidden] {display:none!important;}
+#toolsSection {align-content:start;}
+#toolsSection .inline-sizes {
+  grid-column:1 / -1; margin:0 0 8px;padding:12px 8px;
+  background:rgba(244,236,255,.86);border:1px solid #dbc8f6;border-radius:14px;
+}
+#toolsSection .inline-sizes h2 {font-size:12px;margin:0 0 8px;}
+#toolsSection .brushes {display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;}
+#toolsSection .brushes .brush {min-width:0;min-height:52px;padding:5px 2px;gap:4px;font-size:11px;}
+#toolsSection .brushes small {font-size:9px;line-height:1;color:#645475;}
+#toolsSection button[aria-controls="sizesSection"]::after {content:'⌄';margin-left:auto;font-size:14px;}
+#toolsSection button[aria-expanded="true"]::after {content:'⌃';}
+#selectionBtn.active {color:var(--accent);background:var(--soft);outline:2px solid var(--accent);outline-offset:-2px;}
+.selection-panel {flex:0 0 auto;order:-1;z-index:2;padding:8px 10px;background:rgba(255,255,255,.94);border:1px solid #ddcef5;border-radius:14px;box-shadow:0 3px 12px #39255112;}
+.selection-row {display:flex;align-items:center;gap:5px;flex-wrap:wrap;}
+#selectionTitle {font-size:13px;margin-right:auto;color:#48315f;}
+.selection-row button {min-height:44px;min-width:44px;padding:7px 10px;font-size:13px;border:1px solid #e4d7f5;background:#f7f1ff;box-shadow:none;}
+#selectionApply {background:#6b36d8;color:white;border-color:#6b36d8;}
+#selectionPercent {min-width:48px;text-align:center;font-size:13px;font-variant-numeric:tabular-nums;}
+#selectionHelp {font-size:11px;line-height:16px;margin:5px 0 0;color:#63546f;}
+.selection-editing .canvas-wrap>.hint {display:none;}
+.selection-layer {position:absolute;z-index:5;touch-action:none;user-select:none;-webkit-user-select:none;cursor:crosshair;overflow:hidden;}
+#selectionPreview {position:absolute;min-width:0;min-height:0;max-width:none;max-height:none;display:block;border:0;border-radius:0;box-shadow:none;pointer-events:none;}
+.selection-box {position:absolute;border:2px dashed #773dce;background:transparent;outline:1px solid rgba(255,255,255,.9);pointer-events:none;box-sizing:border-box;}
+@media (max-width:700px), (max-width:1024px) and (max-height:500px) {
+ .tools .drawer-heading {position:sticky;top:-18px;background:#f8f3ff;z-index:3;padding:9px 0;margin-bottom:12px;}
+ #toolsPanelTitle {font-size:15px;}
+ .selection-panel {padding:5px 6px;border-radius:10px;}
+ #selectionTitle {display:none;}
+ .selection-row {gap:3px;justify-content:center;}
+ .selection-row button {font-size:12px;padding:5px 7px;}
+ #selectionHelp {font-size:10px;line-height:14px;margin-top:4px;}
+ #selectionPercent {min-width:40px;font-size:12px;}
+}
+@media (max-width:359px) { .selection-row button {padding-inline:4px;} #selectionAgain {min-width:40px;} }
+@media (forced-colors:active) {.selection-box{border-color:Highlight;} #selectionApply{border:2px solid ButtonText;}}
