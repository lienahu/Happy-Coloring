+.canvas-stage {border-radius:20px;background:rgba(255,255,255,.13);}
+#canvas {border-radius:16px;box-shadow:0 5px 24px #5d3c8724;}
+.hint {font-size:11px;color:#645575;}
+.pan-scroll {background:rgba(193,166,234,.22);}
+.pan-scroll::-webkit-slider-thumb {background:linear-gradient(145deg,#b485fb,#8353d5);border:2px solid #ffffffd9;border-radius:12px;}
+.pan-scroll::-moz-range-thumb {background:#9566e4;border:2px solid white;border-radius:12px;}
+.quick-dock {background:rgba(255,255,255,.65);-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);}
+.quick-dock button {border-radius:13px;}
+.quick-dock button:hover {background:#ffffff75;}
+.drawer-shade,.drawer-shade:hover {background:rgba(34,21,54,.22);}
+.dialog {background:#faf7ff;color:var(--ink);border-color:white;border-radius:24px;box-shadow:0 24px 70px #36204c40;}
+.dialog button {border-radius:14px;min-height:44px;}
+@media (max-width:1150px) {main{grid-template-columns:236px minmax(0,1fr);}.brand{font-size:18px}.tools{padding:12px;}}
+@media (max-width:700px), (max-width:1024px) and (max-height:500px) {
+ main {grid-template-columns:minmax(0,1fr);grid-template-rows:minmax(0,1fr) 60px;padding:0;gap:0;}
+ .tools {background:rgba(250,247,255,.96);padding:18px;border-radius:22px;}
+ .canvas-wrap {padding:58px 6px 4px;gap:0;}
+ .canvas-stage {border-radius:12px;}
+ #canvas {border-radius:8px;}
+ .canvas-view-tools {padding:4px;background:rgba(242,235,255,.88);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);}
+ header {padding:4px 8px;}
+ .top-actions button {border-radius:13px;}
+ .brand-mark {border-radius:10px;}
+ .quick-dock {border:0;border-top:1px solid #ffffff9c;}
+ .tools .palette {gap:5px;}
+ .tools .swatch {min-height:44px;}
+}
+@media (max-width:1024px) and (max-height:500px) and (orientation:landscape) {
+ main {grid-template-columns:60px minmax(0,1fr);grid-template-rows:minmax(0,1fr);}
+ header {padding:4px 6px;}
+ .canvas-wrap {padding:4px;}
+ .canvas-view-tools {background:transparent;padding:0;-webkit-backdrop-filter:none;backdrop-filter:none;}
+ .quick-dock {border:0;border-right:1px solid #ffffff9c;}
+ .tools {inset:4px auto 4px 64px;}
+}
+/* Ensure legible fallbacks when blur/transparency is unsupported or reduced. */
+@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))) {
+ header,.tools,.quick-dock {background:#f8f4ff;}
+}
+@media (prefers-reduced-transparency:reduce) {
+ header,.tools,.quick-dock,.canvas-view-tools {background:#f7f3ff;-webkit-backdrop-filter:none;backdrop-filter:none;}
+}
+@media (forced-colors:active) {
+ .tool-buttons button.active,.brush.active,.bg.active {outline:2px solid Highlight;}
+ .swatch {forced-color-adjust:none;}
+}
