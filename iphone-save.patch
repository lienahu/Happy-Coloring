+function scene(){
+ const calls=[];const ctx={fillStyle:'',fillRect(...x){calls.push(['fill',this.fillStyle,...x])},drawImage(...x){calls.push(['image',...x])}};
+ const output={getContext:()=>ctx};const source=Object.freeze({width:1400,height:1000});
+ return {calls,ctx,output,source,create:()=>output};
+}
+test('export uses full bitmap dimensions, not CSS zoom or viewport',()=>{const s=scene();s.source=Object.freeze({width:1400,height:1000,clientWidth:125,clientHeight:80});save.composePicture(s.source,'#ffe5ef',s.create);assert.equal(s.output.width,1400);assert.equal(s.output.height,1000);assert.deepEqual(s.calls[1],['image',s.source,0,0])});
