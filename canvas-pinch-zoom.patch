   header { min-height: 52px; padding-top: 4px; padding-bottom: 4px; }
   .hint { display: none; }
 }
+
+/* Canvas zoom 1. Only this scroll region changes; app/header/sidebar never scale. */
+.canvas-view-tools {
+  display: flex; flex: 0 0 auto; align-items: center; justify-content: center;
+  flex-wrap: wrap; gap: 6px; touch-action: pan-x pan-y;
+}
+.canvas-view-tools button { min-width: 44px; min-height: 44px; padding: 6px 12px; }
+#zoomLabel { min-width: 48px; text-align: center; font-size: 14px; font-variant-numeric: tabular-nums; }
+.canvas-board {
+  flex: 1 1 0; display: grid; min-width: 0; min-height: 0; overflow: hidden;
+  grid-template-columns: minmax(0,1fr) 24px;
+  grid-template-rows: minmax(0,1fr) 24px; gap: 4px;
+}
+.canvas-stage {
+  display: block; position: relative; grid-column: 1; grid-row: 1;
+  overflow: auto; overscroll-behavior: none; scroll-behavior: auto;
+  /* Explicit, touch-friendly scroll sliders stay visible on iPad.
+     Hide only the platform-native overlay bars; the region remains scrollable. */
+  scrollbar-width: none;
+}
+.canvas-stage::-webkit-scrollbar { width: 0; height: 0; }
+.canvas-stage:focus-visible { outline: 2px solid #7568ff; outline-offset: -2px; }
+.canvas-surface { position: relative; min-width: 100%; min-height: 100%; }
+#canvas { position: absolute; box-shadow: none; border-radius: 0; }
+.pan-scroll {
+  margin: 0; padding: 0; min-width: 0; min-height: 0;
+  appearance: none; -webkit-appearance: none; border: 0; border-radius: 12px;
+  background: #e5e8f3; cursor: grab; visibility: hidden;
+  touch-action: none; accent-color: #7568ff;
+}
+.pan-scroll-x { grid-column: 1; grid-row: 2; width: 100%; height: 24px; }
+.pan-scroll-y { grid-column: 2; grid-row: 1; width: 24px; height: 100%; writing-mode: vertical-lr; direction: ltr; }
+.pan-scroll::-webkit-slider-thumb { appearance: none; -webkit-appearance: none; width: 24px; height: 24px; border: 2px solid white; border-radius: 10px; background: #7568ff; }
+.pan-scroll::-moz-range-thumb { width: 20px; height: 20px; border: 2px solid white; border-radius: 10px; background: #7568ff; }
+@media (max-width: 700px) {
+  .canvas-view-tools { gap: 4px; }
+  .canvas-view-tools button { padding: 5px 8px; }
+  #zoomLabel { min-width: 42px; font-size: 12px; }
+}
